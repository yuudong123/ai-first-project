# 생성·학습 라이브러리를 제외한 웹·분류 추론 전용 이미지.
FROM python:3.11-slim
WORKDIR /app
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=/app OMP_NUM_THREADS=2 OPENBLAS_NUM_THREADS=2
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 && rm -rf /var/lib/apt/lists/*
COPY infra/requirements-server.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt
COPY src /app/src
COPY api /app/api
COPY web /app/web
RUN mkdir -p /app/artifacts/runtime
CMD ["python", "-m", "src.runtime.server_entry", "api"]
