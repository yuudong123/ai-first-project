# 이 파일을 .env.server로 복사하고 서버의 실제 경로·주소로 수정한다.
# 기존 Kafka의 advertised.listeners 주소도 이 컨테이너에서 접근 가능해야 한다.
KAFKA_BROKER=192.168.133.108:9092
KAFKA_TOPIC=hydraulic.sensor.multi.raw
MODEL_HOST_DIR=/srv/hydrotwin/assets/models
DATA_HOST_DIR=/srv/hydrotwin/assets/data
UNITY_WEBGL_HOST_PATH=/srv/hydrotwin/assets/unity/pro-build
# 기본은 서버 내부 접속. 팀 내부망 직접 공개 시 서버의 내부망 IP를 지정한다.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8000
# 배포마다 커밋 번호 등 새 태그를 사용한다.
HYDROTWIN_IMAGE_TAG=local
